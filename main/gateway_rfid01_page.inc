/* RFID01 - pagina compacta; no acciona relé */
static esp_err_t gw_rfid01_page(httpd_req_t *req) {
 if(require_auth(req)!=ESP_OK)return ESP_OK;
 httpd_resp_set_type(req,"text/html; charset=utf-8");
 httpd_resp_sendstr_chunk(req,"<!doctype html><html lang='es'><meta charset='utf-8'><meta name='viewport' content='width=device-width,initial-scale=1'><title>Gateway2 RFID01</title><style>body{background:#17140f;color:#e8e5df;font:14px Arial;margin:20px}h2{color:#ffb300}.wrap{max-width:1050px;margin:auto}.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:10px}.card{background:#242018;border:1px solid #5a4720;border-radius:9px;padding:14px;margin:9px 0}.muted{color:#aaa}input,select{padding:9px;background:#17140f;color:white;border:1px solid #66512b;border-radius:5px}button{padding:10px;background:#ffb300;border:0;border-radius:5px;font-weight:bold;cursor:pointer}code{color:#ffd87c}a{color:#ffb300}small{color:#bbb}</style><div class='wrap'><h2>GATEWAY2 · GPIO / RFID01</h2><p><a href='/'>STATUS</a> · <a href='/sip'>SIP</a> · <a href='/gpio-map'>GPIO SIMULADOR</a></p><div class='grid'><div class='card'><b>CPU</b><p id='cpu'>—</p><small>Frecuencia; carga por nucleo pendiente</small></div><div class='card'><b>HEAP LIBRE / MINIMO</b><p id='heap'>—</p></div><div class='card'><b>FLASH FISICA</b><p id='flash'>—</p></div><div class='card'><b>TIEMPO ACTIVO</b><p id='uptime'>—</p></div></div><div class='card'><h2>SIMULADOR UNIVERSAL DE CREDENCIALES</h2><p class='muted'>Solo evento lógico. No abre puerta.</p><label>Lector <select id='reader'><option value='1'>1</option><option value='2'>2</option></select></label> <label>ID <input id='card' maxlength='40' value='1021254125641' autocomplete='off'></label> <button id='send'>SIMULAR LECTURA</button><p id='result'></p></div><div class='card'><h2>GPIO</h2><p>35 / 36 / 5 / 17: <b>LIBRES DE WIEGAND</b></p><p>4 REX · 39 LLAMADA · 32 SENSOR PUERTA · 33 RELÉ · 14 BALIZA</p><p class='muted'>UART RFID futuro: GPIO sin asignar. No conectar todavía.</p></div><div class='card'><h2>REGISTRO DE SIMULACIÓN</h2><pre id='log'>Sin eventos.</pre></div></div><script>async function poll(){try{let r=await fetch('/api/gw/rfid01/resources');let j=await r.json();document.getElementById('cpu').textContent=j.cpu_mhz+' MHz';document.getElementById('heap').textContent=(j.heap_free/1024).toFixed(1)+' / '+(j.heap_min/1024).toFixed(1)+' KB';document.getElementById('flash').textContent=(j.flash_bytes/1048576).toFixed(2)+' MB';document.getElementById('uptime').textContent=Math.floor(j.uptime_s)+' s'}catch(e){}}document.getElementById('send').onclick=async()=>{let id=document.getElementById('card').value.trim(),reader=document.getElementById('reader').value;if(!/^[A-Za-z0-9:_-]{1,40}$/.test(id)){document.getElementById('result').textContent='ID invalido';return}let r=await fetch('/api/gw/diag',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:new URLSearchParams({action:'rfid01',reader,id})});let j=await r.json();document.getElementById('result').textContent=j.ok?'Evento simulado enviado':'Error';if(j.ok)document.getElementById('log').textContent=new Date().toLocaleTimeString()+' · lector '+reader+' · '+id+'\n'+document.getElementById('log').textContent};poll();setInterval(poll,3000)</script></html>");
 return httpd_resp_sendstr_chunk(req,NULL);
}
static esp_err_t gw_rfid01_resources(httpd_req_t *req) {
 if(require_auth(req)!=ESP_OK)return ESP_OK;
 uint32_t flash=0; esp_flash_get_size(esp_flash_default_chip,&flash);
 char b[240]; snprintf(b,sizeof(b),"{\"cpu_mhz\":%u,\"heap_free\":%u,\"heap_min\":%u,\"flash_bytes\":%u,\"uptime_s\":%lu}",(unsigned)CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ,(unsigned)esp_get_free_heap_size(),(unsigned)esp_get_minimum_free_heap_size(),(unsigned)flash,(unsigned long)(esp_timer_get_time()/1000000LL));
 return send_json(req,b);
}
static const httpd_uri_t URI_RFID01_PAGE={.uri="/gpio-map",.method=HTTP_GET,.handler=gw_rfid01_page};
static const httpd_uri_t URI_RFID01_RES={.uri="/api/gw/rfid01/resources",.method=HTTP_GET,.handler=gw_rfid01_resources};
