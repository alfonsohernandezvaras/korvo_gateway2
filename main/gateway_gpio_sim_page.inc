    httpd_resp_sendstr_chunk(req,"ord'+x.id,String(x.word))});try{let r=await fetch('/api/gw/map',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:p}),d=await r.json();if(!d.rows)throw Error(d.error||'Error NVS');await load();$('gwResult').textContent='Mapa guardado en NVS';}catch(e){$('gwResult').textContent='Error: '+e.message}};\n load();\n})();\n</script>\n");
    httpd_resp_sendstr_chunk(req,"</div></body></html>");
