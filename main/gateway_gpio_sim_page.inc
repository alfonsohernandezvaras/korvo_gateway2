    httpd_resp_sendstr_chunk(req,"box\" class=\"gwen\" data-id=\"'+second.id+'\" '+(second.enabled?'checked':'')+'> Habilitar estado PUERTA ABIERTA';node.appendChild(extra);}})}\n async function load(){try{let r=await fetch('/api/gw/map',{cache:'no-store'}),d=await r.json();if(!r.ok||!d.rows)throw Error(d.error||'Error mapa');rows=d.rows;mapOk=!!d.ok;$('gwSummary').textContent='NVS: '+(d.saved?'GUARDADA':'SIN GUARDAR')+'  |  MAPA: '+d.percent+'%  |  '+(d.ok?'GPIO OK':'INCOMPLETO')+'  |");
    httpd_resp_sendstr_chunk(req,"  REVISION '+d.revision+'  |  Diccionario: V1 local (comparacion remota pendiente)';makeGroup(groups.left,$('gwLeft'));makeGroup(groups.right,$('gwRight'));$('gwResult').textContent='';}catch(e){$('gwResult').textContent='Error: '+e.message}}\n async function sim(action){if(!action)return;let p=new URLSearchParams({action});if(action==='wiegand'){p.set('format',$('gwFormat').value);p.set('facility',$('gwFacility').value);p.set('card',$('gwCard').v");
    httpd_resp_sendstr_chunk(req,"alue)}try{let r=await fetch('/api/gw/diag',{method:'POST',headers:{'Content-Type':'application/x-www-form-urlencoded'},body:p}),d=await r.json();$('gwResult').textContent=d.ok?'SIMULADO: '+action+' (sin cambiar GPIO fisicos)':'ERROR: '+(d.error||'sin respuesta')}catch(e){$('gwResult').textContent=e.message}}\n document.querySelector('.gw-layout').addEventListener('click',e=>{let b=e.target.closest('button.gwsim');if(!b)return;let a=b.dataset.actio");
